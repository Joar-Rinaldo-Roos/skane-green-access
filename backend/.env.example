# Here & Now Mac-only secrets. Copy this file to .env and NEVER commit .env.
# Create a PROJECT API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-project-key-goes-here

# Make a long personal token using: openssl rand -hex 24
# Paste the SAME token in Here & Now's Connect to Mac settings.
HERE_NOW_ACCESS_TOKEN=replace-with-random-token-from-openssl-rand-hex-24

# GitHub Pages frontend is the only browser origin allowed.
ALLOWED_ORIGIN=https://joar-rinaldo-roos.github.io
PORT=8787

# Fast/cost-conscious model. Optional web search can add extra API charges.
OPENAI_MODEL=gpt-5.4-mini
ENABLE_WEB_SEARCH=1
MAX_HOURLY_REQUESTS=30
MAX_DAILY_REQUESTS=80
